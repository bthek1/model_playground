# Edge proxy for the production stack (docker-compose.prod.yml).
#
# Caddy's job is TLS and nothing else: it obtains and renews a certificate for
# $DOMAIN automatically and forwards everything to the nginx container, which
# owns the routing (SPA fallback, and /api -> Django on the same origin).
#
# TLS is a functional requirement, not hardening: `navigator.gpu` is only
# exposed in a secure context, so on plain HTTP every model page in this app
# reports "WebGPU unsupported" on hardware that supports it.

{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip

	# Sets X-Forwarded-Proto: https, which nginx passes through and Django reads
	# via SECURE_PROXY_SSL_HEADER. Without that chain the admin rejects every
	# POST with a CSRF origin mismatch.
	reverse_proxy frontend:80

	log {
		output stdout
		format console
	}
}
