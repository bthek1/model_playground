# Development configuration — one file for both halves (#61).
#
# Copy to `.env` beside this file (`just env-init`) and fill it in. `.env` is
# gitignored and must stay that way — this example is the source of truth for
# *which* variables are required, never for their values.
#
# Read by: backend settings (core/settings/base.py → ../.env), backend/.envrc
# (direnv), vite.config.ts (`envDir: ".."`) and every docker-compose.yml service.
# Only `VITE_*` keys ever reach the browser bundle; the backend secrets below are
# never exposed to the client (frontend/src/__tests__/envExposure.test.ts).
#
# Production does NOT read this file: it uses `.env.prod` (see .env.prod.example).

# ── Django ────────────────────────────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=core.settings.dev
SECRET_KEY=your-secret-key-here
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database ──────────────────────────────────────────────────────────────────
# Defaults to postgres://appuser:apppassword@localhost:5432/appdb if unset
# Use @db:5432 when running inside Docker Compose
DATABASE_URL=postgres://appuser:apppassword@localhost:5432/appdb

# ── CORS ──────────────────────────────────────────────────────────────────────
# Add the frontend origin. The dev server proxies /api same-origin, so this only
# matters if the browser calls Django directly.
CORS_ALLOWED_ORIGINS=https://localhost:5180

# ── Email ─────────────────────────────────────────────────────────────────────
# Override in prod
DEFAULT_FROM_EMAIL=noreply@example.com

# ── Superuser (used by `just be-superuser-create`) ────────────────────────────
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=changeme

# ── Frontend / Vite ───────────────────────────────────────────────────────────
# Leave empty: the app calls /api on its own origin and the Vite dev server
# proxies it to Django (see vite.config.ts). Set this only if the API is served
# from a different origin in your deployment.
VITE_API_BASE_URL=

# Where the dev-server proxy forwards /api. Change if the backend moves ports.
VITE_API_PROXY_TARGET=http://localhost:8006

# `off` builds the static, backend-free app (the S3 + CloudFront deploy, #57):
# no /api call is ever made — no sign-in, no landing page (/ goes to /home), no
# registry catalogue. Unset or `on` keeps the full app. Read in exactly one
# place, src/lib/features.ts.
VITE_BACKEND=on

# Anonymous product analytics (#60) — leave BOTH empty locally. The project
# key (`phc_…`, public and write-only) is set only on CI's shipped build, as a
# GitHub repository *variable*; dev, Vitest and the dev-server E2E run stay
# analytics-free, which is what the "no outbound request" tests rely on.
# Never put the personal `phx_…` key here under a VITE_ name — it would be
# bundled; `npm run check:bundle` fails the build if one reaches dist/.
VITE_POSTHOG_KEY=
# Defaults to /ingest — the same-origin CloudFront behaviour (infra/site).
VITE_POSTHOG_HOST=

# Not here on purpose: AWS credentials (CI deploys through OIDC; `just infra-*`
# uses your local AWS profile) — neither half of the app reads them.
