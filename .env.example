# Deployment configuration for docker-compose.prod.yml.
#
# Copy to `.env` beside this file and fill it in. `.env` is gitignored and must
# stay that way — this example is the source of truth for *which* variables are
# required, never for their values.
#
# The development stack (docker-compose.yml / `just dev`) does not read this
# file; it uses backend/.env.example and frontend/.env.example.
#
# See docs/guides/deployment.md.

# ── The origin ────────────────────────────────────────────────────────────────
# The domain Caddy will obtain a certificate for. It must already resolve to
# this host, or the ACME challenge fails and nothing is served over TLS.
DOMAIN=playground.example.com
# Where Let's Encrypt sends expiry warnings.
ACME_EMAIL=you@example.com

# ── Django ────────────────────────────────────────────────────────────────────
# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
# Changing it invalidates every session and password-reset link.
SECRET_KEY=

# Hosts Django will answer for. Comma-separated, no scheme.
ALLOWED_HOSTS=playground.example.com

# Required behind a TLS-terminating proxy: Django checks the Origin header of
# unsafe requests against this list, so /admin/ logins fail without it. Comma-
# separated and *with* the scheme, unlike ALLOWED_HOSTS.
CSRF_TRUSTED_ORIGINS=https://playground.example.com

# Only needed if you serve the SPA from a different origin than the API. The
# intended deployment is same-origin, where CORS is not involved at all — read
# the note in docs/guides/deployment.md before setting this.
# CORS_ALLOWED_ORIGINS=

LOG_LEVEL=INFO

# ── Database ──────────────────────────────────────────────────────────────────
# Postgres is not published outside the compose network, but this password is
# still a real secret: it is the credential for every backup you take.
POSTGRES_DB=appdb
POSTGRES_USER=appuser
POSTGRES_PASSWORD=

# ── Email (optional) ──────────────────────────────────────────────────────────
DEFAULT_FROM_EMAIL=noreply@example.com
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
